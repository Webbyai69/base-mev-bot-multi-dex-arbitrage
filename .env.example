# ---- Base RPC -------------------------------------------------------------
# HTTP JSON-RPC endpoint for Base mainnet. The public endpoint works for a first
# run but is rate-limited; an Alchemy / QuickNode / Ankr free tier is better.
RPC_URL=https://mainnet.base.org

# Optional WebSocket endpoint (wss://...). If set, new blocks are pushed instead
# of polled. Note: Alchemy bills websocket events by size (~40 CU per block), so on
# a metered plan the adaptive HTTP poll (no WS_URL) is the cheaper choice.
WS_URL=

# ---- Low-RPC mode ------------------------------------------------------------
# events = update pools from each block's logs (one eth_getLogs shared with the MEV
#          feed and the liquidation monitor) and re-read only what changed
# full   = re-read every pool every block (the old behaviour; ~4x the RPC usage)
REFRESH_MODE=events
# Re-read every pool anyway every N blocks. In events mode this doubles as a
# self-check: any pool whose log-driven state differs is logged as "drift".
FULL_REFRESH_BLOCKS=150
# More than this many blocks behind -> one full re-read instead of a long log catch-up
MAX_LOG_GAP=30
# Comma-separated backup HTTP endpoints, used in order when the active one keeps
# failing (the bot returns to RPC_URL after 5 minutes). Public endpoints have no
# monthly quota, e.g. https://mainnet.base.org (more at chainlist.org/chain/8453);
# run "node dist/main.js check" after adding one.
RPC_FALLBACK_URLS=

# ---- Mode -----------------------------------------------------------------
# paper  = find + simulate + log opportunities, never send a transaction
# live   = actually send transactions (requires EXECUTOR_ADDRESS + PRIVATE_KEY)
MODE=paper

# ---- Strategy knobs ---------------------------------------------------------
# Minimum simulated profit (after gas) in USD before an opportunity is logged/sent
MIN_PROFIT_USD=0.25
# Minimum pool liquidity (in WETH-equivalent) for a pool to be watched
MIN_POOL_LIQUIDITY_WETH=2
# Maximum number of pools to watch (largest first). Keep the per-block multicall small.
MAX_POOLS=400
# Gas limit assumed for a two-hop arbitrage when estimating cost in paper mode
ARB_GAS_LIMIT=260000
# Priority fee to assume/bid in gwei
PRIORITY_FEE_GWEI=0.005

# Verify every opportunity by injecting the ArbExecutor bytecode into eth_call via a
# state override (exact, sees fee-on-transfer tokens, needs no deployment). Set to
# false only if your RPC rejects state overrides.
SIM_OVERRIDE=true

# ---- Upgrade 1: concentrated liquidity (Uniswap V3 + Aerodrome Slipstream) --
# Watch and trade CL pools too. Run "discover" once after turning this on.
CL_POOLS=true

# ---- Upgrade 2: multi-hop routes -------------------------------------------
# Triangular (3-hop) and CL routes, verified by RouteExecutor.simulate() via a
# state override (no deployment needed) or each DEX's quoter. Paper only.
MULTI_HOP=true
MAX_HOPS=3
# Routes optimised per block (best marginal edge first)
MAX_CYCLES=150
# Paper gas model in gas units: fixed + per V2-style hop + per CL hop
GAS_ROUTE_BASE=70000
GAS_HOP_V2=75000
GAS_HOP_CL=115000
# Flash-loan source for routes: morpho (free), balancer, capital
FLASH_SOURCE=morpho
# Optional: a deployed contracts/RouteExecutor.sol (exact simulation through your own contract)
ROUTE_EXECUTOR_ADDRESS=

# ---- Upgrade 3: Flashblocks (react within ~200ms instead of 2s) -------------
# Re-reads "hot" pools at Base's pre-confirmed state between blocks. Uses its own
# RPC endpoint; it must be Flashblocks-aware (the public one is). Base says
# Flashblocks may be deprecated in a future hardfork, so this is optional.
FLASHBLOCKS=false
FLASHBLOCKS_RPC_URL=https://mainnet.base.org
FLASHBLOCK_POLL_MS=400
FLASHBLOCK_MAX_POOLS=120

# ---- Upgrade 4: Aave V3 liquidation monitor (paper) ------------------------
LIQUIDATIONS=true
# Blocks of Borrow events read at start-up to find borrowers (grows over time; saved in data/)
LIQ_LOOKBACK_BLOCKS=1800
# Check near-the-line borrowers every N blocks (others 12x less often)
LIQ_CHECK_EVERY=5
# Assumed cost of swapping seized collateral back to the debt token, in bps
LIQ_SWAP_COST_BPS=30

# ---- Risk ------------------------------------------------------------------
# Comma-separated token addresses the bot must never watch or trade
TOKEN_BLACKLIST=

# ---- Dashboard ---------------------------------------------------------------
# While the bot runs, open http://localhost:8787 in a browser on this PC.
# It only listens on this computer, never shows keys, and can't change this file.
UI=true
UI_PORT=8787
# The bot's PUBLIC address (0x + 40 hex characters), so the dashboard can show its
# gas balance, top it up from your wallet and authorise it on the RouteExecutor.
# Never put a private key here. Left blank it's worked out from PRIVATE_KEY if set.
BOT_ADDRESS=

# ---- Telegram alerts -----------------------------------------------------------
# 1) Message @BotFather in Telegram, send /newbot, paste the token below.
# 2) Send your new bot any message, then run:  node dist/main.js telegram
#    It prints your chat id; paste it below. Run it again for a test message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Alert on verified opportunities worth at least this much after gas (USD)
ALERT_MIN_PROFIT_USD=5
# Alert on liquidatable Aave positions with at least this estimated profit (USD)
ALERT_MIN_LIQ_PROFIT_USD=25
# Hard cap on messages per hour, so a bug can never flood your phone
ALERT_MAX_PER_HOUR=20

# ---- Live mode only -------------------------------------------------------
# Address of your deployed ArbExecutor contract (see contracts/ArbExecutor.sol)
EXECUTOR_ADDRESS=
# Private key of the wallet that owns the executor. NEVER commit this file.
PRIVATE_KEY=
# Live safety rails: daily gas budget, and the circuit breaker that writes the
# STOP file after this many failed transactions in a row
MAX_DAILY_GAS_USD=20
MAX_CONSECUTIVE_FAILURES=5

# ---- MEV market feed ------------------------------------------------------
# Run the arbitrage/sandwich classifier on every block (EigenPhi-style feed)
MEV_FEED=true
# Watch these bot addresses specifically (comma separated), e.g. competitors
WATCH_BOTS=

# ---- Discovery & RPC pacing ------------------------------------------------
# activity = watch pools that actually traded in the last DISCOVERY_LOOKBACK_BLOCKS
#            blocks (cheap; works on the public RPC). full = enumerate every pool on
#            every factory (tens of thousands of calls; needs a real provider).
DISCOVERY=activity
DISCOVERY_LOOKBACK_BLOCKS=900
# Blocks per eth_getLogs request during discovery. The bot shrinks this automatically
# when a provider caps it (Alchemy's free tier allows 10; QuickNode/Ankr allow far more).
DISCOVERY_LOG_RANGE=100
# Request pacing. Left blank the bot picks safe values for the public endpoint
# (1 request at a time, 350ms apart) and fast ones for anything else.
RPC_CONCURRENCY=
RPC_MIN_INTERVAL_MS=
RPC_BATCH_MAX_COUNT=

# ---- Files -----------------------------------------------------------------
DATA_DIR=./data
REPORT_DIR=./reports
LOG_LEVEL=info

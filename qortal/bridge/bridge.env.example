# Copy to bridge.env (gitignored) and fill in. Names and placeholders only here.
# The bot's local server (the same address you open the terminal on).
BOT_API_URL=http://127.0.0.1:8787
# An agent token with the READ scope only: terminal → AI agents → Issue token.
# The bridge refuses to start with a token that can tune, pause or deploy.
BOT_AGENT_TOKEN=
# The bridge listens on this machine only.
BRIDGE_PORT=8790
# The Qortal origins allowed to read through the bridge (comma-separated).
# Leave empty for Qortal's local defaults; the bridge prints any origin it
# refuses, so you can add yours here.
QAPP_ORIGINS=

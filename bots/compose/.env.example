# NAMES ONLY. Joshua adds these lines, with his own values, to bots/wrapper/.env
# (gitignored, owner-only). Agents never read or write that file.
# Paper mode needs NO exchange API keys: both bots use public market data.

# Freqtrade REST API (local only, 127.0.0.1). Pick a username, a long random password
# and a long random JWT secret. The bridge reads the same names.
FREQTRADE_API_USERNAME=
FREQTRADE_API_PASSWORD=
FREQTRADE_JWT_SECRET=
# Optional: FREQTRADE_API_PORT (default 8080), FREQTRADE_STRATEGY (default SampleStrategy),
#           FREQTRADE_IMAGE (default freqtradeorg/freqtrade:2026.9)

# Hummingbot keystore password (the first one used becomes the keystore password).
HUMMINGBOT_PASSWORD=

# NOT used this week (live is off). For later, after Joshua's go-live decision, trade-only
# keys with withdrawals OFF and an IP allow-list would go under names like these:
# FREQTRADE__EXCHANGE__KEY / FREQTRADE__EXCHANGE__SECRET  (Freqtrade reads FREQTRADE__* itself)
# Hummingbot stores its keys encrypted via `hbot connect <exchange>`, not in .env.

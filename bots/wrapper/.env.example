# Copy to bots/wrapper/.env (gitignored) and fill in on your own PC.
# Agents never read or edit this file. Keys and URLs never go into git.

# --- Live switches: leave at 0. Live also needs --live on the wrapper command line, typed by you.
FLEET_LIVE_MORPHO_LIQUIDATOR=0
FLEET_LIVE_COMPOUND_LIQUIDATOR=0
FLEET_LIVE_BLIND_BACKRUN=0
FLEET_LIVE_TRIANGULAR=0
FLEET_LIVE_UNISWAPX_FILLER=0
FLEET_LIVE_HUMMINGBOT=0
FLEET_LIVE_FREQTRADE=0
FLEET_LIVE_PASSIVBOT=0
FLEET_LIVE_JITO_SEARCHER=0

# --- Your cap per bot per day (USD of gas). The dashboard can only lower it, never raise it.
FLEET_GAS_CAP_USD_MAX=1

# --- RPC endpoints the external bots read from (your own URLs; keep them out of git)
BASE_RPC_URL=
ETH_RPC_URL=
ARB_RPC_URL=
OP_RPC_URL=
SOLANA_RPC_URL=

{
  "name": "base-arb-bot",
  "version": "0.8.0",
  "description": "Cross-DEX atomic arbitrage bot for Base with paper-trading mode and an on-chain MEV market feed (arbitrage classifier, competitor leaderboard, daily report).",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "discover": "node dist/main.js discover",
    "scan": "node dist/main.js scan",
    "report": "node dist/main.js report",
    "check": "node dist/main.js check",
    "test": "node --test test/*.test.js",
    "test:contracts": "forge test",
    "digest": "node dist/main.js digest",
    "build:bytecode": "node scripts/build-bytecode.cjs",
    "new-wallet": "node dist/main.js new-wallet",
    "carry-over": "node scripts/carry-over.mjs",
    "ui": "node dist/main.js ui",
    "telegram": "node dist/main.js telegram",
    "qortal:nodes": "node qortal/nodes/nodes.mjs",
    "qortal:bridge": "node qortal/bridge/bridge.mjs",
    "qortal:qapp": "node qortal/qapp/build-qapp.mjs",
    "release:qortal": "node scripts/release-qortal.mjs",
    "upstreams": "node scripts/fetch-upstreams.mjs"
  },
  "dependencies": {
    "ethers": "^6.11.1",
    "ws": "^8.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "typescript": "^5.4.2"
  }
}

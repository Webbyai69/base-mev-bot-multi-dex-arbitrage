# Base arb-bot — Ashburn send-path .env (EXAMPLE; copy to .env and fill in). NO SECRETS IN THIS FILE.
#
# This shows only what's DIFFERENT on the Ashburn box. Copy every other line — your executor addresses,
# daily gas cap, bidding (LIVE_* ), learning and liquidation settings — VERBATIM from your home .env so
# the two boxes behave identically except for location and the key store.

# --- Mode: paper for the test week; flip to live ONLY after the paper-week GO/NO-GO (see ashburn-plan.md).
MODE=paper

# --- RPC: a US-East endpoint in the same metro as the sequencer (dRPC free, or your Alchemy free tier).
#     The public Base RPC is a fine fallback. Do NOT pay for a "Flashblocks" plan — the edge is physical
#     proximity, not the pending tag (which Denim removes). See the plan's data-source section.
RPC_URL=https://base.replace-with-your-us-east-endpoint
# WS_URL=wss://base.replace-with-your-us-east-ws        # optional
RPC_FALLBACK_URLS=https://mainnet.base.org

# --- Keep the Flashblocks poll OFF. Proximity is the win here, and Denim retires the pending tag.
FLASHBLOCKS=false

# --- Operator key: the ENCRYPTED keystore, never a plaintext PRIVATE_KEY on this box.
#     Create it with `node dist/main.js encrypt-wallet`, then set this and DELETE any PRIVATE_KEY line.
KEYSTORE_FILE=./data/keystore.json
#     Passphrase at boot comes from the systemd credential (arb-bot.service wires KEYSTORE_PASSPHRASE_FILE).
#     For a quick manual test you can instead `export KEYSTORE_PASSPHRASE=...` in your shell (less secure).

# --- Your deployed contracts: copy the exact addresses from your home .env.
EXECUTOR_ADDRESS=0xYOUR_ARB_EXECUTOR
ROUTE_EXECUTOR_ADDRESS=0xYOUR_ROUTE_EXECUTOR
# LIQ_EXECUTOR_ADDRESS=0xYOUR_LIQ_EXECUTOR
# LIQUIDATIONS_LIVE=false

# --- Optional shared dashboard: point both boxes at the same Cloudflare Worker to compare side by side.
# CLOUD_URL=https://your-worker.workers.dev

# --- Everything else (MAX_* gas cap, MIN_PROFIT_USD, LIVE_MAX_BID_*, PRIORITY_FEE_GWEI, LEARN_*,
#     liquidation settings, etc.): copy from your home .env unchanged.

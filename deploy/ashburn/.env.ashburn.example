# Base arb-bot: server .env (EXAMPLE). NO SECRETS IN THIS FILE.
#
# The usual way to make the server's .env is make-server-env.sh, run on the PC: it reads your home .env and
# applies exactly the overrides below without printing anything; you upload only the result:
#   bash deploy/ashburn/make-server-env.sh .env server.env
# Use this file only to see what differs, or to build a .env by hand. Copy every other line (executor
# addresses, daily gas cap, bidding LIVE_*, learning and liquidation settings) VERBATIM from home, so the
# two copies scan identically and the comparison is only about location.

# --- Paper only. Only one copy may ever send live transactions, and that's the home PC until you decide.
MODE=paper
LIQUIDATIONS_LIVE=false

# --- No wallet key on this box. Paper mode starts without one (only MODE=live requires PRIVATE_KEY or a
#     keystore), so there is no PRIVATE_KEY and no KEYSTORE_FILE line here: the server cannot sign even if
#     MODE is changed by mistake. When you go live here, use the encrypted keystore (README), never a
#     plaintext PRIVATE_KEY.
# KEYSTORE_FILE=./data/keystore.json

# --- Dashboard: always 127.0.0.1 (the bot never listens on other interfaces). Port 8788 so the tunnel
#     (ssh -L 8788:127.0.0.1:8788) doesn't clash with the home PC's 8787. The page checks the Host header
#     against its own port, so tunnel to the same port number on both ends.
UI_PORT=8788

# --- RPC: keep your home settings unless you choose a US-East provider for the server.
RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_FALLBACK_URLS=https://mainnet.base.org
# FLASHBLOCKS / FLASHBLOCKS_RPC_URL: copy from home so both copies scan the same way.

# --- Your deployed contracts: copy from home so the server's dashboard and checks match it.
EXECUTOR_ADDRESS=0xYOUR_ARB_EXECUTOR
ROUTE_EXECUTOR_ADDRESS=0xYOUR_ROUTE_EXECUTOR
# LIQ_EXECUTOR_ADDRESS=0xYOUR_LIQ_EXECUTOR

DATA_DIR=./data
REPORT_DIR=./reports
